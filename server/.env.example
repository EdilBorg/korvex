# ═══════════════════════════════════════════════════════════
# Korvex Server — Variáveis de Ambiente (FASE 3.1)
# Copiar este ficheiro para .env e preencher os valores reais.
# NUNCA commitar o .env com credenciais reais.
# ═══════════════════════════════════════════════════════════

# Porta do servidor (padrão: 3001)
PORT=3001

# URL do frontend (para CORS) — ex: https://korvex.app ou http://localhost:5500
FRONTEND_URL=http://localhost:5500

# Caminho para a chave de serviço do Firebase Admin SDK
# Obter em: Firebase Console → Definições → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Ou, alternativamente, pode definir as credenciais directamente:
# FIREBASE_PROJECT_ID=korvex-ebf
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@korvex-ebf.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Inteligência Artificial (FASE IA) ────────────────────────────────
# Chave da API do Google Gemini Flash (gratuita — aistudio.google.com)
# Sem esta chave o fallback de IA fica silenciosamente desactivado.
GEMINI_API_KEY=

# ── Pagamentos — PaySuite (assinatura Korvex Premium) ────────────────
# NUNCA colocar o token real neste ficheiro de exemplo nem no frontend.
# Preencher apenas no .env real do servidor (nunca é exposto ao browser).
PAYSUITE_BASE_URL=https://paysuite.tech
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=

# ── Modo de desenvolvimento ────────────────────────────────────────────
# Quando "development", activa POST /dev/mark-paid (pagamento simulado,
# ver server/payments/index.js — devMarkPaid). NUNCA definir como
# "development" em produção.
NODE_ENV=development
