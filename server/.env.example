# ═══════════════════════════════════════════════════════════
# Korvex Server — Variáveis de Ambiente
# ───────────────────────────────────────────────────────────
# 1. Copiar este ficheiro:  cp server/.env.example server/.env
# 2. Preencher os valores reais no .env
# 3. NUNCA commitar o ficheiro .env (está no .gitignore)
# ═══════════════════════════════════════════════════════════

# Porta do servidor (padrão: 3001)
PORT=3001

# URL do frontend (para CORS)
# Local:  http://localhost:5500
# Prod:   https://teu-dominio.com
FRONTEND_URL=http://localhost:5500

# ── Firebase Admin SDK ─────────────────────────────────────
# Opção A (recomendada): ficheiro JSON da conta de serviço
# Firebase Console → Definições do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Opção B: variáveis individuais (alternativa ao ficheiro)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Inteligência Artificial (Google Gemini) ────────────────
# Obter em: https://aistudio.google.com/apikey
# Sem esta chave o fallback de IA fica desactivado (silencioso).
GEMINI_API_KEY=

# ── Pagamentos — PaySuite ──────────────────────────────────
# NUNCA colocar tokens reais neste ficheiro de exemplo.
PAYSUITE_BASE_URL=https://paysuite.tech
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=

# ── Ambiente ───────────────────────────────────────────────
# development = activa rotas de teste (ex: POST /dev/mark-paid)
# production  = desactiva rotas de teste — USAR SEMPRE EM PRODUÇÃO
NODE_ENV=development
